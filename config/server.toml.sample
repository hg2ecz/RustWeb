# RWLang server production configuration sample.
# Copy to /usr/local/etc/rwlang/server.toml, adapt paths/limits, chmod appropriately,
# then validate with: rwlang-server --config /usr/local/etc/rwlang/server.toml --check-config
#
# All filesystem paths in TOML configuration must be absolute.
# Secrets are referenced by *_file; do not put passwords or database URLs here.
# For Host-routed multi-domain deployments see config/server-multidomain.toml.sample.
# `server.app` is the legacy single-domain mode and cannot be combined with [[domains]].

[server]
app = "/srv/rwlang/current/main.rw"
listen = "0.0.0.0:443"
insecure_dev_cookies = false

[tls]
cert_file = "/run/secrets/rwlang/tls-fullchain.pem"
key_file = "/run/secrets/rwlang/tls-key.pem"
handshake_timeout_ms = 5000
http_redirect_listen = "0.0.0.0:80"
public_host = "www.example.com"

[database]
url_file = "/run/secrets/rwlang/database-url"
allow_insecure = false

[redis]
url_file = "/run/secrets/rwlang/redis-url"
allow_insecure = false

[auth]
# Choose LDAP or local auth. Do not configure both as primary identity backends.
# ldap_url = "ldaps://ldap.internal.example"
# ldap_search_base = "ou=people,dc=example,dc=com"
# ldap_username_attribute = "uid"
# ldap_service_bind_dn_file = "/run/secrets/rwlang/ldap-bind-dn"
# ldap_service_bind_password_file = "/run/secrets/rwlang/ldap-bind-password"
# totp_secrets_file = "/run/secrets/rwlang/totp-secrets"
# roles_file = "/usr/local/etc/rwlang/auth-roles"
# local_auth_db_url_file = "/run/secrets/rwlang/local-auth-db-url"
require_totp = false
login_max_attempts = 8
login_window_secs = 300

[web]
trusted_proxy_cidrs = []
allow_missing_origin = false
cors_origins = []
cors_allow_credentials = false

[storage]
data_root = "/srv/rwlang/data"
fs_mode = "rwc"
max_upload_bytes = 16777216
# Hard ceiling for decoded image dimensions (width * height).
max_image_pixels = 40000000

[static_assets]
root = "/srv/rwlang/current/public"
url_prefix = "/assets/"
max_asset_bytes = 8388608
max_age_secs = 300
immutable_max_age_secs = 31536000
precompressed = true

[lifecycle]
health_live_path = "/health/live"
health_ready_path = "/health/ready"
health_dependency_timeout_ms = 1000
shutdown_grace_ms = 30000

[observability]
metrics_listen = "127.0.0.1:9090"
allow_public_metrics = false
access_log = true

# Three logical classes: error/system, normal HTTP access, user/security activity audit.
# Log directories must already exist. Files are created in append mode if absent.
# SIGHUP reopens these files after logrotate; it does NOT reload server config.
[logging]
server_file = "/var/log/rwlang/server.log" # error/system
access_file = "/var/log/rwlang/access.log" # normal serving
audit_file = "/var/log/rwlang/audit.log"   # user/security activity
stderr = true

[rate_limit]
policies_file = "/usr/local/etc/rwlang/rate-limits.toml"
allow_memory = false

[cache]
max_ttl_secs = 3600
max_entries = 10000
max_bytes = 67108864
allow_memory = false

[reload]
# Shared low-cost mtime+size watcher for the application source graph.
enabled = true
poll_interval_ms = 1000
debounce_ms = 250

[limits]
max_header_bytes = 16384
max_body_bytes = 262144
max_connections = 4096
max_requests_per_connection = 100
read_timeout_ms = 5000
request_timeout_ms = 15000
write_timeout_ms = 5000
max_header_count = 64
max_form_fields = 64
max_form_field_bytes = 8192
max_instructions = 5000000
max_runtime_alloc_bytes = 268435456
session_ttl_secs = 28800
max_sessions = 100000
max_process_memory_bytes = 1073741824
resource_profiles_file = "/usr/local/etc/rwlang/resource-profiles.toml"

# Optional only when the operator delegates a writable cgroup v2 directory
# directly to rwlang-server. Do not enable this together with the systemd
# MemoryMax/CPUQuota/TasksMax baseline from examples/systemd/rwlang.service.
# [cgroup]
# dir = "/sys/fs/cgroup/rwlang/app"
# memory_max_bytes = 1073741824
# memory_swap_max_bytes = 0
# cpu_percent = 200
# pids_max = 256
